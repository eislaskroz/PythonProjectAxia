# AXIA - plantilla de configuración. NUNCA coloques secretos reales aquí.
AXIA_ENV=development
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU_CLAVE_ANON_PUBLICA
AXIA_DATA_KEY=GENERA_UNA_LLAVE_FERNET_Y_RESPALDALA

# Seguridad
AXIA_REQUIRE_ENCRYPTION=1
# Solo desarrollo local: genera AXIA_DATA_KEY automáticamente si falta.
# En ejecutables o producción esta opción nunca genera claves automáticamente.
AXIA_AUTO_PROVISION_DEV_KEY=1
AXIA_ALLOW_LEGACY_PLAINTEXT_PASSWORDS=0
AXIA_LOGIN_MAX_ATTEMPTS=5
AXIA_LOGIN_LOCK_MINUTES=15
AXIA_ENABLE_IP_GEOLOCATION=1

# Correo automático de levantamientos
# El PDF se envía al guardar o actualizar cualquier formato de levantamiento.
AXIA_MAIL_ENABLED=1
AXIA_MAIL_FROM=levantamientos@axiacomunicaciones.mx
AXIA_MAIL_TO=mmachuca@axiacomunicaciones.mx
AXIA_MAIL_CC=desarrollo.01@axiacomunicaciones.mx

# Hosting propio: confirma estos datos en el panel de correo del hosting.
# Ejemplo frecuente en cPanel: mail.tudominio.com / 465 + SSL o 587 + STARTTLS.
AXIA_SMTP_HOST=
AXIA_SMTP_PORT=587
AXIA_SMTP_USER=levantamientos@axiacomunicaciones.mx
AXIA_SMTP_PASSWORD=
AXIA_SMTP_SSL=0
AXIA_SMTP_STARTTLS=1
AXIA_SMTP_TIMEOUT=12

# Cierre automático de sesión por inactividad (minutos)
AXIA_IDLE_TIMEOUT_MINUTES=20

# ===============================
# ACTUALIZACIONES DE AXIA
# ===============================
AXIA_UPDATE_CHECK_ENABLED=true
AXIA_UPDATE_CHANNEL=stable
